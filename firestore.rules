rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Secure the global API keys document
    match /settings/global_api_keys {
      // Any authenticated user can read the API keys
      allow read: if request.auth != null;
      
      // ONLY the super admin can save/update the API keys
      allow write: if request.auth != null && request.auth.token.email == "barasagodwil@gmail.com";
    }
    
    // By default, deny read/write access to all other documents
    match /{document=**} {
      allow read, write: if false;
    }
    
  }
}
